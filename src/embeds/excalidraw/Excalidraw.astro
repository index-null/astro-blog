---
import { load } from "cheerio";

interface Props {
  href: string;
  src: string;
  alt: string;
  caption?: string;
  class?: string;
}

const { href, src, alt, caption, class: className } = Astro.props;

// Import all SVG files from /src/ as raw strings
const svgFiles = import.meta.glob("/src/**/*.svg", {
  query: "?raw",
  import: "default",
});

const svgSource = src || href;

let svgContent = "";

if (!svgSource) {
  console.error("Excalidraw: no src or href provided");
  svgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 20 200 50" width="100%" height="100%">
    <text x="10" y="50" fill="red">No SVG source provided</text>
  </svg>`;
} else if (svgSource.startsWith("<svg")) {
  svgContent = svgSource;
} else {
  let file = svgFiles[svgSource];
  if (!file) {
    console.error(`SVG file not found: ${svgSource}`);
    svgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 20 120 50" width="100%" height="100%">
      <text x="10" y="50" fill="red">SVG not found</text>
    </svg>`;
  } else {
    svgContent = (await file()) as string;
  }
}

// Only set responsive attributes — keep original Excalidraw colors intact
function prepareSvg(svgString: string): string {
  const $ = load(svgString, { xmlMode: true });

  const svg = $("svg");
  svg.attr("width", "100%");
  svg.attr("height", "100%");
  svg.addClass("w-full h-auto");

  return $.html();
}

let preparedSvg = "";

try {
  preparedSvg = prepareSvg(svgContent);
} catch (error) {
  console.error("Error processing SVG:", error);
  preparedSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
    <text x="10" y="50" fill="red">Error loading SVG</text>
  </svg>`;
}
---

<figure class:list={["mx-auto max-w-full overflow-hidden my-8", className]}>
  <div class="excalidraw-svg" aria-label={alt} set:html={preparedSvg} />
  {
    caption && (
      <figcaption class="text-center mt-4 text-sm text-base-700 dark:text-base-300 italic">
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .excalidraw-svg {
    @apply w-full max-w-full overflow-hidden;
  }
  :global(.excalidraw-svg svg) {
    @apply w-full h-auto;
  }
  /*
    Dark mode: CSS invert filter — Excalidraw 官方推荐的暗色模式做法。
    反转亮度 + 旋转色相，保留原始色彩关系和层次感，零 JS 成本。
  */
  :global(.dark .excalidraw-svg svg) {
    filter: invert(1) hue-rotate(180deg);
  }
</style>
