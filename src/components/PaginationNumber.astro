---
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const { index, active, tag } = Astro.props;
---

<a
  href={tag ? getLocalizedPath(lang, "/tags/" + tag + "/" + index) : getLocalizedPath(lang, "/pages/" + index)}
  class:list={[
    "inline-flex items-center border-t-2 px-4 pt-4 text-sm font-medium",
    active
      ? "border-accent-500 text-accent-600"
      : "border-transparent text-base-500 hover:border-base-300 hover:text-base-700 dark:text-base-400 dark:hover:border-base-700 dark:hover:text-base-300",
  ]}>{index}</a
>
