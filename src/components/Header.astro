---
import {
  BASE,
  MANUAL_DARK_MODE,
  SEARCH_ENABLED,
  SITE_FAVICON,
  SITE_NAME,
  SITE_TITLE,
  SHOW_FAVICON_IN_HEADER,
} from "../config.ts";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitcher from "./LangSwitcher.astro";
import HeaderLink from "./HeaderLink.astro";
import CodeCopyButton from "./CodeCopyButton.astro";

import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/utils";

import CommandPalette from "./search/CommandPalette.svelte";
import Search from "./search/Search.svelte";

const { active } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header>
  <nav
    class="flex items-center justify-between p-6 lg:px-8"
    aria-label="Global"
  >
    <div class="flex lg:flex-1">
      <a href={getLocalizedPath(lang, "/")} class="p-1.5">
        <span class="sr-only">go to home</span>

        <div class="text-3xl flex items-center gap-x-2">
          {SHOW_FAVICON_IN_HEADER ? SITE_FAVICON : null}
          <span
            class="hidden md:block font-bold text-base text-base-950 dark:text-base-50"
            >{SITE_NAME || SITE_TITLE}</span
          >
        </div>
      </a>
    </div>
    <div class="flex gap-x-4 sm:gap-x-10 items-center">
      <HeaderLink
        href={getLocalizedPath(lang, "/")}
        active={active === "blog"}
        class="text-sm font-semibold leading-6">{t("nav.blog")}</HeaderLink
      >
      <HeaderLink
        href={getLocalizedPath(lang, "/about")}
        active={active === "about"}
        class="text-sm font-semibold leading-6">{t("nav.about")}</HeaderLink
      >

      {MANUAL_DARK_MODE ? <ThemeToggle /> : null}
      <LangSwitcher />

      {SEARCH_ENABLED ? <Search client:visible /> : null}
    </div>
  </nav>
</header>

<CommandPalette client:load />
<CodeCopyButton />
