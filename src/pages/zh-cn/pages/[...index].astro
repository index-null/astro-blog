---
import { POSTS_PER_PAGE } from "../../../config.ts";
import { getBlogPosts } from "src/utils";
import PostList from "$layouts/PostList.astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const lang = "zh-cn";
  const posts = await getBlogPosts(lang);
  return Array.from({ length: Math.ceil(posts.length / POSTS_PER_PAGE) }).map(
    (_, index) => ({
      params: { index: (index + 1).toString() },
      props: { index: index + 1 },
    })
  );
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { index } = Astro.props;

const posts = (await getBlogPosts(lang)).splice(
  POSTS_PER_PAGE * (index - 1),
  POSTS_PER_PAGE
);
const total = Math.ceil((await getBlogPosts(lang)).length / POSTS_PER_PAGE);
---

<PostList
  {posts}
  totalPages={total}
  currentPage={index}
  showFeatured={index === 1}
>
  <h1>
    {t("home.all")}
    {total > 0 ? ` - ${t("home.page")} ${index}` : ""}
  </h1>
</PostList>
