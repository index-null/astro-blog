---
import { SITE_TITLE, SITE_DESCRIPTION } from "../../../config.ts";

import Footer from "$components/Footer.astro";
import Header from "$components/Header.astro";
import BaseLayout from "$layouts/BaseLayout.astro";
import BlogPost from "$layouts/BlogPost.astro";
import { Content } from "$content/info/en/about.mdx";
import { getLangFromUrl } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} lang={lang}>
  <Header active="about" />

  <main class="max-w-2xl lg:max-w-3xl mx-auto mt-8 px-4">
    <BlogPost>
      <Content />
    </BlogPost>
  </main>

  <Footer />
</BaseLayout>
