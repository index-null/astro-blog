---
import { POSTS_PER_PAGE } from "../../config.ts";
import { getBlogPosts } from "src/utils";
import PostList from "$layouts/PostList.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = (await getBlogPosts(lang)).splice(0, POSTS_PER_PAGE);
const total = Math.ceil((await getBlogPosts(lang)).length / POSTS_PER_PAGE);
---

<PostList {posts} totalPages={total} currentPage={1} showFeatured>
  <h1>{t("home.latest")}</h1>
</PostList>
